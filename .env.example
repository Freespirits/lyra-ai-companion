# ---- LLM brain ----
# Providers: ollama | anthropic (API key) | claude-code | codex | gemini-cli
# The last three need NO API key: they spawn the locally installed CLI that
# carries your own subscription login (claude -p / codex exec / gemini).
LLM_PROVIDER=ollama
#ANTHROPIC_API_KEY=sk-ant-...
#ANTHROPIC_MODEL=claude-sonnet-4-6
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
# optional: semantic memory recall ("ollama pull nomic-embed-text"). Empty = keyword recall.
OLLAMA_EMBED_MODEL=

# ---- STT ----
# With a key: Deepgram nova live streaming (best accuracy + endpointing).
# Without: free Web Speech API (Chrome/Edge).
DEEPGRAM_API_KEY=

# ---- Voice ----
# elevenlabs (recommended, eleven_v3 audio tags) | edge (free) | browser
TTS_PROVIDER=edge
EDGE_VOICE=en-US-AriaNeural
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# eleven_v3 = expressive audio tags ([laughs], [whispers]...). Fallback: eleven_multilingual_v2
ELEVENLABS_MODEL=eleven_v3

# 8787 sits inside a Windows reserved port range (netsh excludedportrange); 8686 is safe
PORT=8686

# ---- Environmental sync (aura) ----
# hue (Philips Hue local bridge) | ha (Home Assistant webhook) | off
AURA_PROVIDER=off
HUE_BRIDGE_IP=
HUE_USERNAME=
HUE_GROUP=0
HA_URL=http://homeassistant.local:8123
HA_WEBHOOK_ID=lyra_aura

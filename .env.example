# ---- LLM brain ----
# Providers: ollama | anthropic (API key) | claude-code | codex | gemini-cli | openclaw
# claude-code/codex/gemini-cli need NO API key: they spawn the locally installed CLI
# that carries your own subscription login (claude -p / codex exec / gemini).
# openclaw = bridge to your own OpenClaw agent; it owns the brain, so zero model config.
LLM_PROVIDER=ollama
#ANTHROPIC_API_KEY=sk-ant-...
#ANTHROPIC_MODEL=claude-sonnet-4-6
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
# optional: semantic memory recall ("ollama pull nomic-embed-text"). Empty = keyword recall.
OLLAMA_EMBED_MODEL=
# OpenClaw bridge (LLM_PROVIDER=openclaw): token from ~/.openclaw/openclaw.json (gateway.auth.token)
#OPENCLAW_TOKEN=
#OPENCLAW_URL=ws://127.0.0.1:18789

# ---- Content guard (optional, OFF by default) ----
# The characters' no-romance boundary lives in their identity and is ALWAYS on
# (see server/archetypes.js GUARDRAILS) — it holds with this guard off. This is only
# an extra opt-in moderation pass on top. Set LYRA_GUARD=on to enable a fast keyword
# filter that blocks explicit sexual / aggressive / harmful replies (she redirects in
# character). 'off' (default) disables it.
LYRA_GUARD=off
# Optional stronger semantic layer via Ollama, on top of the keyword filter (only runs
# when LYRA_GUARD=on AND this is set). NOTE: the small llama-guard3:1b tends to over-flag
# warm, platonic companion talk as unsafe — prefer llama-guard3:8b if you use it.
# Empty = keyword-only. Pull once: `ollama pull llama-guard3:8b`.
GUARD_MODEL=

# ---- STT ----
# With a key: Deepgram nova live streaming (best accuracy + endpointing).
# Without: free Web Speech API (Chrome/Edge).
DEEPGRAM_API_KEY=

# ---- Voice ----
# elevenlabs (recommended, eleven_v3 audio tags) | edge (free) | browser
TTS_PROVIDER=edge
EDGE_VOICE=en-US-AriaNeural
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# eleven_v3 = expressive audio tags ([laughs], [whispers]...). Fallback: eleven_multilingual_v2
ELEVENLABS_MODEL=eleven_v3

# 8787 sits inside a Windows reserved port range (netsh excludedportrange); 8686 is safe
PORT=8686

# ---- Access control (security) ----
# The server binds loopback (127.0.0.1) only by default. To reach Lyra from your
# phone / other devices, set BIND_HOST=0.0.0.0 AND a LYRA_TOKEN — the server
# REFUSES to expose the LAN unauthenticated. Clients then pass the token
# (?token=... on the URL, or an Authorization: Bearer header).
#BIND_HOST=127.0.0.1
#LYRA_TOKEN=
# extra allowed browser origins (comma-separated), if you serve the UI elsewhere:
#LYRA_ORIGINS=
#JSON_LIMIT=16mb

# ---- Environmental sync (aura) ----
# hue (Philips Hue local bridge) | ha (Home Assistant webhook) | off
AURA_PROVIDER=off
HUE_BRIDGE_IP=
HUE_USERNAME=
HUE_GROUP=0
HA_URL=http://homeassistant.local:8123
HA_WEBHOOK_ID=lyra_aura

# LYRA_MEMORY=off freezes all persistent-memory writes (recall still works). For test sessions that should leave no trace.
# LYRA_MEMORY=on
